{
  "name": "lnwjud",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --build",
    "test": "pnpm -r --if-present test",
    "test:integration": "vitest run tests/integration/mcp-development-flow.test.ts tests/integration/codex-review-flow.test.ts",
    "test:packaging": "vitest run tests/packaging/desktop-packaging.test.ts",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "test:e2e": "corepack pnpm@10.15.0 -r --if-present test:e2e",
    "build": "pnpm -r --if-present build"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@types/node": "^24.0.0",
    "@lnwjud/application": "workspace:*",
    "@lnwjud/audit": "workspace:*",
    "@lnwjud/codex": "workspace:*",
    "@lnwjud/domain": "workspace:*",
    "@lnwjud/mcp-server": "workspace:*",
    "@lnwjud/process": "workspace:*",
    "@lnwjud/storage": "workspace:*",
    "@lnwjud/workspace": "workspace:*",
    "eslint": "9.33.0",
    "typescript": "6.0.0-dev.20250819",
    "typescript-eslint": "8.39.0",
    "vitest": "3.2.4"
  }
}
